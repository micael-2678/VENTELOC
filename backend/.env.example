# ===========================================
# VenteLoc - Variables d'environnement du backend
# ===========================================
# Copiez ce fichier en .env et remplissez les valeurs. AUCUNE valeur réelle ici : ce fichier est versionné.
# Générez les secrets avec : openssl rand -hex 32

# Environnement : production désactive /docs et /openapi.json
ENV=development
APP_VERSION=

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=venteloc_dev

# Sécurité JWT (32 caractères minimum)
JWT_SECRET=

# Stripe Identity (https://dashboard.stripe.com/apikeys) : clé secrète et secret du webhook Identity
STRIPE_SECRET_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=
# (STRIPE_WEBHOOK_SECRET, ancien nom, n'est lu que si STRIPE_IDENTITY_WEBHOOK_SECRET est vide)

# Brevo pour les e-mails (https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=

# Suivi d'erreurs optionnel (plan gratuit Sentry) : vide = désactivé
SENTRY_DSN=

# Marque et URL publique (e-mails, PDF, sitemap, mentions)
SITE_NAME=VenteLoc
SITE_URL=http://localhost:3000
# (FRONTEND_URL, ancien nom, n'est lu que si SITE_URL est vide)
# Origines CORS autorisées (séparées par des virgules) ; vide = SITE_URL (+ localhost hors production). Jamais « * ».
CORS_ORIGINS=

# E-mails : expéditeur (domaine authentifié dans Brevo : SPF, DKIM, DMARC) et boîte qui reçoit les notifications admin.
# SENDER_EMAIL est obligatoire en production (vide = contact@venteloc.fr, refusé par Brevo hors de ce domaine).
SENDER_EMAIL=
SENDER_NAME=
# Plafond souple d'e-mails par jour (UTC) : au-delà, seuls les e-mails transactionnels partent encore (plan gratuit
# Brevo : 300 par jour). 0 = pas de plafond. Les échecs d'envoi apparaissent dans l'écran admin « À faire ».
EMAIL_DAILY_SOFT_LIMIT=250
ADMIN_NOTIFICATION_EMAIL=

# Compte administrateur créé au démarrage (connexion protégée par un code envoyé par e-mail)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Honoraires de négociation (docs/venteloc/SPEC.md §7.1) : taux HT du prix de vente et minimum HT, à la charge du
# vendeur, dus à la signature de l'acte authentique (TVA 20 % en sus ; défauts : 3 % HT, 3 000 € HT)
COMMISSION_RATE_PERCENT=3
COMMISSION_MIN_HT=3000
FF_SELLER_COMMISSION=true
FF_MANDATE_REQUIRED=true
FF_OTP_SIGNATURE=true
# Limitation de débit (5/min connexion, inscription, mot de passe oublié ; 10/min codes de signature)
RATE_LIMIT_ENABLED=true
# Mode test (docs/venteloc/SPEC.md §10) : TEST_MODE=true ouvre les routes /api/test/* (identité et
# e-mail simulés, comptes et annonces de démonstration, connexion rapide, boîte mail de test), capture chaque e-mail dans
# db.test_emails, renvoie les codes de signature et de connexion admin en clair, assouplit les contrôles de publication
# et marque tout ce qui est créé `is_test` (registre des mandats TEST-0001, factures TEST-FAC-…, documents « DOCUMENT DE
# TEST — SANS VALEUR JURIDIQUE »). Affaiblit l'authentification admin : réservé à un essai, toujours false en exploitation.
# Purge : POST /api/admin/test/purge ou python -m migrations.purge_test_data --apply.
TEST_MODE=false
# En mode test, les e-mails capturés partent aussi par Brevo si true (et BREVO_API_KEY défini) ; jamais vers @test.local
TEST_MODE_SEND_EMAILS=false
# Mot de passe commun des comptes de démonstration vendeur.demo / acquereur.demo / admin.demo@test.local (vide = Demo-2026!)
TEST_DEMO_PASSWORD=
# Clé du panneau de test : le panneau /test, les données et la connexion rapide aux comptes démo, l'admin démo et le code
# de connexion admin en clair ne sont accessibles qu'en ouvrant l'application avec ?cle=<clé> (en-tête X-Test-Key).
# Vide : panneau ouvert à tous ; en production, l'admin démo est alors fermé. À définir pour tout essai en ligne.
TEST_PANEL_KEY=
# Adresse IP réelle du client : nombre de proxys qui ajoutent une entrée à X-Forwarded-For. Le nginx du frontend
# résout déjà l'adresse derrière Traefik (realip) et ne transmet qu'une entrée : 1 est la valeur exacte avec
# docker-compose.yml (2 = Traefik puis un nginx sans realip ; 0 = backend exposé directement, en-tête ignoré).
# L'en-tête n'est lu que si le pair direct est dans TRUSTED_PROXY_NETWORKS (CIDR séparés par des virgules ;
# vide = réseaux privés, dont le réseau Docker).
TRUSTED_PROXY_HOPS=1
TRUSTED_PROXY_NETWORKS=

# Mentions légales (AlterEgo SAS, carte T)
LEGAL_CARTE_T="CPI 7801 2025 000 000 049"
# Représentant légal et directeur de la publication : vide = valeur par défaut du backend (Romane DA SILVA RIBEIRO)
LEGAL_REPRESENTANT=
# Hébergeur (LCEN) : nom, adresse et téléphone, par exemple
# LEGAL_HEBERGEUR="Hetzner Online GmbH, Industriestr. 25, 91710 Gunzenhausen, Allemagne, +49 9831 505-0"
LEGAL_HEBERGEUR=
LEGAL_RC_PRO=
LEGAL_MEDIATEUR=
# Adresse de contact affichée dans les contrats (exercice des droits RGPD) et les mentions ; vide = SENDER_EMAIL
LEGAL_EMAIL=
# Téléphone affiché dans les mentions légales (facultatif ; vide = pas de ligne « Téléphone »)
LEGAL_PHONE=
# Activités portées par la carte T, séparées par « ; » (défaut : Transactions sur immeubles et fonds de commerce).
# N'ajouter « ;Gestion immobilière » que si la carte la porte.
# LEGAL_CARTE_T_ACTIVITES=Transactions sur immeubles et fonds de commerce
# N° de TVA intracommunautaire (facultatif : calculé depuis le SIREN d'AlterEgo sinon)
LEGAL_TVA=
# Identité de la société (valeurs par défaut du backend ci-dessous) : à décommenter seulement pour les changer.
# Une variable définie mais vide efface la mention correspondante.
# LEGAL_DENOMINATION=AlterEgo
# LEGAL_FORME_JURIDIQUE="Société par actions simplifiée"
# LEGAL_CAPITAL=2000
# LEGAL_ADRESSE="43 rue Massenet, 78500 Sartrouville"
# LEGAL_RCS_VILLE=Versailles
# LEGAL_SIREN=952180230
# LEGAL_CARTE_T_VALIDITE=28/07/2028
# LEGAL_CARTE_T_CCI="CCI Paris Île-de-France"

# Factures d'honoraires
INVOICE_IBAN=
INVOICE_BIC=
INVOICE_BANK=

# Statistiques maison (POST /api/events) : sel des empreintes de visiteurs, facultatif (défaut : JWT_SECRET)
EVENTS_SALT_SECRET=

# Open data : INPI facultatif
INPI_USERNAME=
INPI_PASSWORD=

# Stockage des fichiers compatible S3 (optionnel ; vide = fichiers dans MongoDB, 10 Mo max)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_BACKUP_PREFIX=backups
# Chiffrement côté serveur SSE-S3 (AES256) des fichiers envoyés ; false si le fournisseur refuse cet en-tête
S3_SSE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Tâches planifiées (toutes les heures ; quotidiennes / hebdomadaires / mensuelles gérées par claim_once)
JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=3600
# Dossier des archives mongodump (volume partagé avec le service backup) : la dernière est envoyée vers S3 chaque jour
BACKUP_DIR=/backups
