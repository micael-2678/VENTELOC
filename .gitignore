# ===========================================
# VenteLoc - Git Ignore
# ===========================================

# Environnement
.env
.env.local
.env.*.local
*.env

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.yarn/cache
.yarn/install-state.gz

# Build
build/
dist/
*.egg-info/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
logs/
*.log

# Tests
test_*.py
*_test.py
test_result.md
coverage/
.coverage

# Emergent (ne pas modifier)
.emergent/

# Temporaires
tmp/
temp/
*.tmp

# Environment files (les modèles *.env.example sont versionnés)
*.env
*.env.*
!*.env.example

# Tests du dépôt (versionnés)
!backend/tests/test_*.py
