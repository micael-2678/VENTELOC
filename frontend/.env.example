# Variables de build du frontend (Create React App : lues au build, jamais à l'exécution)
# Marque affichée (logo, titres, pied de page). Défaut : CessionBâtiment ; CessionRGE reste la verticale RGE.
REACT_APP_BRAND_NAME=CessionBâtiment
# Domaine public : URLs canoniques, Open Graph, JSON-LD, sitemap (même valeur que SITE_URL côté backend)
REACT_APP_SITE_URL=https://cessionbatiment.fr
# E-mail de contact affiché (défaut : contact@<domaine du site>)
REACT_APP_CONTACT_EMAIL=
# URL du backend vue du navigateur : vide = même domaine (/api proxifié par nginx)
REACT_APP_BACKEND_URL=
# Minimum de commission affiché (= COMMISSION_MIN_HT côté backend)
REACT_APP_COMMISSION_MIN_HT=4000
# URL du site vitrine WordPress (facultatif) : lien « Site » du pied de page de l'application. Les e-mails continuent
# d'utiliser SITE_URL (l'application). Ex. https://www.cessionbatiment.fr ; vide = pas de lien.
REACT_APP_MARKETING_URL=
# Pas de sourcemaps en production
GENERATE_SOURCEMAP=false

# ---- Variable d'exécution du conteneur nginx (pas une variable de build) ----
# Origines autorisées à afficher le module /embed/annonces dans une iframe (site WordPress), séparées par des
# espaces : en-tête Content-Security-Policy « frame-ancestors 'self' <origines> » de /embed/ uniquement (frontend/nginx.conf,
# docs/WORDPRESS.md). Vide = même origine seulement. Toutes les autres pages restent interdites en iframe (DENY).
EMBED_ALLOWED_ORIGINS=
