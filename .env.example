# ===========================================
# VenteLoc - Variables Docker Compose
# ===========================================
# Copiez ce fichier en .env pour docker-compose (ou collez-le dans l'onglet Environment du service Compose de Dokploy).
# AUCUNE valeur réelle ici : ce fichier est versionné. Générez les secrets avec : openssl rand -hex 32
# Une valeur qui contient des espaces s'écrit entre guillemets doubles.

# Environnement : production désactive /docs et /openapi.json
ENV=production
APP_VERSION=

# MongoDB (utilisateur admin créé au premier démarrage)
MONGO_PASSWORD=
DB_NAME=venteloc_prod

# Backend
JWT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_IDENTITY_WEBHOOK_SECRET=
# (STRIPE_WEBHOOK_SECRET, ancien nom, n'est lu que si STRIPE_IDENTITY_WEBHOOK_SECRET est vide)
BREVO_API_KEY=
# Suivi d'erreurs optionnel (plan gratuit Sentry) : vide = désactivé
SENTRY_DSN=

# Marque et URL publique (reprises par le backend, les e-mails, les PDF et le build du frontend)
SITE_NAME=VenteLoc
SITE_URL=https://venteloc.fr
# Origines CORS autorisées (séparées par des virgules) ; vide = SITE_URL. Jamais « * ».
CORS_ORIGINS=
# Site vitrine WordPress (facultatif, voir docs/WORDPRESS.md) : lien « Site » du pied de page de l'application
# (variable de build du frontend : redéployer après un changement), ex. MARKETING_URL=https://www.venteloc.fr
MARKETING_URL=
# Origines autorisées à afficher le module /embed/annonces dans une iframe, séparées par des espaces
# (ex. "https://www.venteloc.fr https://venteloc.fr") ; vide = l'application seule
EMBED_ALLOWED_ORIGINS=
# Page « vendre mon entreprise » du site WordPress : cible (301) des anciennes adresses /vendre-mon-entreprise-…
# (ex. https://www.venteloc.fr/vendre-mon-entreprise/) ; vide = /estimer (estimateur de l'application)
SELLER_LANDING_URL=

# E-mails : expéditeur (domaine authentifié dans Brevo : SPF, DKIM, DMARC, voir DOKPLOY_DEPLOYMENT.md) et boîte qui
# reçoit les notifications admin. SENDER_EMAIL est OBLIGATOIRE en production (adresse du domaine SITE_URL) : vide, les
# envois partent de contact@venteloc.fr et Brevo les refuse si ce domaine n'est pas authentifié chez vous.
# Brevo gratuit : 300 e-mails par jour, codes de connexion et de signature compris.
SENDER_EMAIL=
SENDER_NAME=
ADMIN_NOTIFICATION_EMAIL=
# Plafond souple par jour (UTC) : au-delà, seuls les e-mails transactionnels partent (0 = pas de plafond)
EMAIL_DAILY_SOFT_LIMIT=250

# Compte administrateur créé au démarrage (connexion protégée par un code envoyé par e-mail)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Honoraires de négociation (docs/venteloc/SPEC.md §7.1) : taux HT du prix de vente et minimum HT, à la charge du
# vendeur, dus à la signature de l'acte authentique (TVA 20 % en sus ; défauts : 3 % HT, 3 000 € HT)
COMMISSION_RATE_PERCENT=3
COMMISSION_MIN_HT=3000
FF_SELLER_COMMISSION=true
FF_MANDATE_REQUIRED=true
FF_OTP_SIGNATURE=true
RATE_LIMIT_ENABLED=true
# Mode test (essai de l'application sans vérification d'identité réelle, voir DOKPLOY_DEPLOYMENT.md « Mode test ») :
# e-mails capturés dans la boîte de test, documents « DOCUMENT DE TEST — SANS VALEUR JURIDIQUE ». Toujours false en exploitation.
TEST_MODE=false
# En mode test, envoyer aussi les e-mails par Brevo (en plus de la boîte de test)
TEST_MODE_SEND_EMAILS=false
# Mot de passe commun des comptes de démonstration (vide = Demo-2026!)
TEST_DEMO_PASSWORD=
# Clé du panneau de test (ouvrir l'application avec ?cle=<clé>) : à définir pour tout essai en ligne
TEST_PANEL_KEY=
# Adresse IP réelle du client : nginx (frontend/nginx.conf) ne transmet qu'une adresse dans X-Forwarded-For ;
# laisser ces valeurs par défaut (voir backend/.env.example)
TRUSTED_PROXY_HOPS=1
TRUSTED_PROXY_NETWORKS=

# Mentions légales (AlterEgo SAS, carte T)
LEGAL_CARTE_T="CPI 7801 2025 000 000 049"
# Représentant légal et directeur de la publication : vide = valeur par défaut du backend
LEGAL_REPRESENTANT=
# Hébergeur (LCEN) : nom, adresse et téléphone, par exemple
# LEGAL_HEBERGEUR="Hetzner Online GmbH, Industriestr. 25, 91710 Gunzenhausen, Allemagne, +49 9831 505-0"
LEGAL_HEBERGEUR=
LEGAL_RC_PRO=
LEGAL_MEDIATEUR=
# Adresse de contact des contrats (art. 10.2 du mandat, NDA) et des mentions légales ; vide = SENDER_EMAIL
LEGAL_EMAIL=
# Téléphone affiché dans les mentions légales (facultatif)
LEGAL_PHONE=
# Activités de la carte T séparées par « ; » (ajouter « ;Gestion immobilière » seulement si la carte la porte)
# LEGAL_CARTE_T_ACTIVITES=Transactions sur immeubles et fonds de commerce
# N° de TVA intracommunautaire (facultatif : calculé depuis le SIREN d'AlterEgo sinon)
LEGAL_TVA=
# Identité de la société (valeurs par défaut du backend ci-dessous) : à décommenter seulement pour les changer
# (changement de siège, renouvellement de la carte T…). Une ligne laissée vide effacerait la mention.
# LEGAL_DENOMINATION=AlterEgo
# LEGAL_FORME_JURIDIQUE="Société par actions simplifiée"
# LEGAL_CAPITAL=2000
# LEGAL_ADRESSE="43 rue Massenet, 78500 Sartrouville"
# LEGAL_RCS_VILLE=Versailles
# LEGAL_SIREN=952180230
# LEGAL_CARTE_T_VALIDITE=28/07/2028
# LEGAL_CARTE_T_CCI="CCI Paris Île-de-France"

# Factures d'honoraires (coordonnées bancaires imprimées sur les factures)
INVOICE_IBAN=
INVOICE_BIC=
INVOICE_BANK=

# Statistiques maison (POST /api/events) : sel des empreintes de visiteurs, facultatif (défaut : JWT_SECRET)
EVENTS_SALT_SECRET=

# Open data : INPI facultatif (recherche-entreprises.api.gouv.fr est utilisé sans clé)
INPI_USERNAME=
INPI_PASSWORD=

# Stockage des fichiers compatible S3 (recommandé en production ; vide = fichiers dans MongoDB, 10 Mo max)
# Ex. Scaleway : S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud S3_REGION=fr-par
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_BACKUP_PREFIX=backups
# Chiffrement côté serveur SSE-S3 (AES256) des fichiers envoyés ; false si le fournisseur refuse cet en-tête
S3_SSE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Tâches planifiées (relances, expirations, sauvegarde S3) et sauvegardes locales
JOBS_ENABLED=true
# Intervalle de la boucle des tâches en secondes (les tâches quotidiennes et hebdomadaires restent uniques)
JOBS_INTERVAL_SECONDS=3600
# Nombre d'archives mongodump conservées (une par jour)
BACKUP_RETENTION_DAYS=14
# Heure UTC de la sauvegarde (23 = juste avant la copie quotidienne vers S3, faite dans l'heure qui suit minuit UTC)
BACKUP_HOUR=23
